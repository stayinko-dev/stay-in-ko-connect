{
  "version": 1,
  "sdk_version": "3.1.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vaxybtgeoeomrqjhvkit.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "stayinko-connect",
      "version": "0.1.0",
      "title": "StayInKo Connect"
    },
    "tools": [
      {
        "name": "search_listings",
        "title": "Search listings",
        "description": "Search StayInKo housing listings in Korea (Seoul, Busan, Daejeon, Gwangju). Filter by city, keyword, property type, price, or nearby university. Returns public listing details.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "keyword": {
              "description": "Free-text keyword matched against title, location, and description.",
              "type": "string",
              "maxLength": 100
            },
            "city": {
              "description": "City to filter by.",
              "type": "string",
              "enum": [
                "Seoul",
                "Busan",
                "Daejeon",
                "Gwangju"
              ]
            },
            "property_type": {
              "description": "Property type filter.",
              "type": "string",
              "enum": [
                "studio",
                "apartment",
                "guesthouse",
                "officeTel",
                "share",
                "coliving",
                "private",
                "women_only"
              ]
            },
            "max_price": {
              "description": "Maximum monthly price in KRW.",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "no_deposit_only": {
              "description": "When true, only return listings with no deposit.",
              "type": "boolean"
            },
            "university": {
              "description": "Nearby university name, e.g. 'Hanyang' or 'Yonsei'.",
              "type": "string",
              "maxLength": 100
            },
            "limit": {
              "description": "Maximum number of results (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_favorites",
        "title": "List my favorite listings",
        "description": "List the signed-in user's saved (favorite) housing listings with basic listing details.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_bookings",
        "title": "List my bookings",
        "description": "List the signed-in user's bookings, either as a guest (stays they booked) or as a host (bookings on their listings). Includes dates, status, and payment status.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "role": {
              "description": "Bookings where you are the guest (default) or the host.",
              "type": "string",
              "enum": [
                "guest",
                "host"
              ]
            },
            "status": {
              "description": "Filter by booking status.",
              "type": "string",
              "enum": [
                "pending",
                "confirmed",
                "completed",
                "cancelled"
              ]
            },
            "limit": {
              "description": "Maximum number of results (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
